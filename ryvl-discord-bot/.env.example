# This template is for local Docker Compose. The native Oracle/PM2 deployment
# reads server/.env instead; use server/.env.example for its production template.
DB_PASSWORD=your_secure_db_password
DATABASE_URL=postgresql://ryvl:your_secure_db_password@localhost:5432/ryvl
# Inside Compose, DATABASE_URL is set to the db service by docker-compose.yml.

# Discord Developer Portal -> Application -> Bot / OAuth2. Never commit secrets.
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
JWT_SECRET=replace-with-a-random-secret-generated-by-openssl-rand-hex-32

# Native Oracle production values (configure these in server/.env):
# FRONTEND_URL=https://ryvl.top
# DISCORD_OAUTH_REDIRECT_URI=https://ryvl.top/api/auth/discord/callback
# For local development use the actual frontend port and register this callback:
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
FRONTEND_URL=http://localhost:4200
PORT=3000
