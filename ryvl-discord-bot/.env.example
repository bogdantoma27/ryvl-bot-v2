# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# For local Docker Compose / Oracle Cloud:
DB_PASSWORD=your_secure_db_password
DATABASE_URL=postgresql://ryvl:your_secure_db_password@localhost:5432/ryvl
# (Inside docker-compose, DATABASE_URL is automatically set to connect to the db service container)

# -----------------------------------------------------------------------------
# Discord Developer Portal Credentials
# -----------------------------------------------------------------------------
# https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Discord OAuth2 Redirect URI (Must match what you put in Discord Developer Portal -> OAuth2 -> Redirects):
# Local Dev: http://localhost:3000/api/auth/discord/callback
# Oracle Cloud: http://<your-oracle-ip-or-domain>/api/auth/discord/callback
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# -----------------------------------------------------------------------------
# Auth Configuration
# -----------------------------------------------------------------------------
# Any random 32+ character string
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security

# -----------------------------------------------------------------------------
# Frontend & Server Settings
# -----------------------------------------------------------------------------
# Local Dev: http://localhost:4200
# Oracle Cloud: http://<your-oracle-ip-or-domain>
FRONTEND_URL=http://localhost:4200
PORT=3000
