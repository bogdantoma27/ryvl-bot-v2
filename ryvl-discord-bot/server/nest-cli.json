{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "assets/**/*", "outDir": "dist/src/assets" },
      { "include": "**/*.jpg", "outDir": "dist" },
      { "include": "**/*.png", "outDir": "dist" }
    ]
  }
}
