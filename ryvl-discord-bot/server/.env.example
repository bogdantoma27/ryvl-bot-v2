# On a NEW VM installation only: cp -n .env.example .env, then edit .env.
# Do not overwrite an existing .env and never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Discord Developer Portal -> Application -> Bot / OAuth2.
DISCORD_TOKEN=replace-with-discord-bot-token
DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret

# Register this EXACT callback in Discord Developer Portal -> OAuth2 -> Redirects.
DISCORD_OAUTH_REDIRECT_URI=https://ryvl.top/api/auth/discord/callback

# Generate a unique random value with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Public origin for OAuth return URLs, CORS and all Discord club website buttons.
FRONTEND_URL=https://ryvl.top

# Internal backend port; Caddy is the public HTTPS entry point.
PORT=3000

# Local development ONLY: change FRONTEND_URL to your actual Angular dev origin
# and use http://localhost:3000/api/auth/discord/callback as the registered callback.
# WEB_BASE_URL is obsolete; do not configure a separate public website origin.
# Polling schedules and Discord channel selections are configured in the admin panel.
