# Copy this file to ".env" on the server and replace every placeholder.
# Never commit the real .env file.
#
# Production Oracle VM example:
#   cp .env.example .env
#   nano .env

# PostgreSQL connection string.
# Use the real production database host/user/password/database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Discord Developer Portal -> Application -> Bot.
DISCORD_TOKEN=replace-with-discord-bot-token

# Discord Developer Portal -> OAuth2.
DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret

# Production on Oracle VM:
#   http://<ORACLE_PUBLIC_IP>/api/auth/discord/callback
#
# If a domain + HTTPS is configured later:
#   https://your-domain.example/api/auth/discord/callback
DISCORD_OAUTH_REDIRECT_URI=http://<ORACLE_PUBLIC_IP>/api/auth/discord/callback

# Must be at least 32 characters.
# Generate one with:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Production on Oracle VM:
#   http://<ORACLE_PUBLIC_IP>
#
# If a domain + HTTPS is configured later:
#   https://your-domain.example
FRONTEND_URL=http://<ORACLE_PUBLIC_IP>

# NestJS stays behind Caddy on this local port.
PORT=3000

# FRONTEND_URL is also the source for Discord "View club on web" buttons.
# Do not add a separate localhost WEB_BASE_URL in production.
# Notification schedules/intervals and Discord channels are saved in the admin panel, not here.
