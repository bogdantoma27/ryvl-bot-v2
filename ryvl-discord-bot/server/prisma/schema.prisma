generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id               String   @id // Discord guild snowflake
  name             String
  iconUrl          String?  @map("icon_url")
  timezone         String   @default("Europe/Bucharest")
  defaultChannelId String?  @map("default_channel_id")
  defaultLineupChannelId      String?  @map("default_lineup_channel_id")
  defaultTransfersChannelId   String?  @map("default_transfers_channel_id")
  defaultFixturesChannelId    String?  @map("default_fixtures_channel_id")
  defaultStandingsChannelId   String?  @map("default_standings_channel_id")
  defaultLiveResultsChannelId String?  @map("default_live_results_channel_id")
  defaultRyvlResultsChannelId     String?  @map("default_ryvl_results_channel_id")
  defaultRyvlFixturesChannelId    String?  @map("default_ryvl_fixtures_channel_id")
  defaultRyvlLeaderboardChannelId String?  @map("default_ryvl_leaderboard_channel_id")
  defaultContactChannelId         String?  @map("default_contact_channel_id")
  defaultRecruitmentChannelId     String?  @map("default_recruitment_channel_id")
  ryvlTeamName                    String   @default("RYVL Esports") @map("ryvl_team_name")
  joinedAt           DateTime            @default(now()) @map("joined_at")
  events             Event[]
  lineupDrafts       LineupDraft[]
  clubTrackerConfig  ClubTrackerConfig?
  processedEaMatches ProcessedEaMatch[]
  vpgTransferConfig      VpgTransferConfig?
  processedVpgTransfers  ProcessedVpgTransfer[]
  processedVpgMatches    ProcessedVpgMatch[]
  ryvlCompetitions       RyvlCompetition[]
  vpgNotificationConfig VpgNotificationConfig?
  vpgNotificationDeliveries VpgNotificationDelivery[]
  registeredPlayers     RegisteredDiscordPlayer[]
  totwConfigs           TotwConfig[]
  tournamentConfig      TournamentConfig?
  tournamentInstances   TournamentInstance[]
  trackedClubs          TrackedClub[]

  @@map("guilds")
}

model RyvlCompetition {
  id            String   @id @default(uuid())
  guildId       String   @map("guild_id")
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  communitySlug String   @default("VPGRoPS5") @map("community_slug")
  season        Int?
  active        Boolean  @default(true)
  displayOrder  Int      @default(1) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([guildId, slug])
  @@map("ryvl_competitions")
}

model LineupDraft {
  id                 String    @id @default(uuid())
  guildId            String    @map("guild_id")
  guild              Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title              String    @default("RYVL Match Lineup")
  channelId          String?   @map("channel_id")
  formation          String    @default("433")
  kickoffAt          DateTime? @map("kickoff_at")
  timezone           String    @default("Europe/Bucharest")
  mentionRoleIds     String[]  @default([]) @map("mention_role_ids")
  assignments        Json      @default("{}")
  createdByDiscordId String    @map("created_by_discord_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("lineup_drafts")
}

model Event {
  id             String      @id @default(uuid())
  guildId        String      @map("guild_id")
  guild          Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  location       String?
  imageUrl       String?     @map("image_url")
  color          String      @default("#5865F2")
  channelId      String      @map("channel_id")
  timezone       String      @default("Europe/Bucharest")
  createdById    String      @map("created_by_id")
  mentionRoleIds String[]    @default([]) @map("mention_role_ids")
  rrule          String?     // RFC 5545 RRULE string, null = one-off
  duration       Int         @default(60) // Duration in minutes
  status         EventStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  occurrences    EventOccurrence[]

  @@map("events")
}

model EventOccurrence {
  id          String           @id @default(uuid())
  eventId     String           @map("event_id")
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  index       Int
  startsAt    DateTime         @map("starts_at")
  endsAt      DateTime?        @map("ends_at")
  status      OccurrenceStatus @default(SCHEDULED)
  messageId   String?          @map("message_id")
  channelId   String?          @map("channel_id")
  publishedAt DateTime?        @map("published_at")
  closedAt    DateTime?        @map("closed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  rsvps       Rsvp[]

  @@unique([eventId, index])
  @@map("event_occurrences")
}

model Rsvp {
  id           String          @id @default(uuid())
  occurrenceId String          @map("occurrence_id")
  occurrence   EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  userId       String          @map("user_id")
  displayName  String          @map("display_name")
  avatarUrl    String?         @map("avatar_url")
  status       RsvpStatus
  respondedAt  DateTime        @default(now()) @map("responded_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@unique([occurrenceId, userId])
  @@map("rsvps")
}

enum EventStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OccurrenceStatus {
  SCHEDULED
  PUBLISHED
  CLOSED
  CANCELLED
}

enum RsvpStatus {
  ACCEPTED
  TENTATIVE
  DECLINED
}

model ClubTrackerConfig {
  id              String    @id @default(uuid())
  guildId         String    @unique @map("guild_id")
  guild           Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  clubId          String    @default("128199") @map("club_id")
  clubName        String    @default("RYVL Esports") @map("club_name")
  platform        String    @default("common-gen5")
  channelId       String?   @map("channel_id")
  enabled         Boolean   @default(true)
  matchTypes      String[]  @default(["leagueMatch", "friendlyMatch", "playoffMatch"]) @map("match_types")
  pollIntervalSec Int       @default(90) @map("poll_interval_sec")
  lastPolledAt    DateTime? @map("last_polled_at")
  lastMatchId     String?   @map("last_match_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("club_tracker_configs")
}

model ProcessedEaMatch {
  id               String   @id @default(uuid())
  eaMatchId        String   @map("ea_match_id")
  guildId          String   @map("guild_id")
  guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  clubId           String   @map("club_id")
  matchType        String   @map("match_type")
  homeClubName     String   @map("home_club_name")
  awayClubName     String   @map("away_club_name")
  homeScore        Int      @map("home_score")
  awayScore        Int      @map("away_score")
  timestamp        DateTime
  discordMessageId String?  @map("discord_message_id")
  channelId        String?  @map("channel_id")
  rawPayload       Json?    @map("raw_payload")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([guildId, eaMatchId])
  @@map("processed_ea_matches")
}

model VpgTransferConfig {
  id              String    @id @default(uuid())
  guildId         String    @unique @map("guild_id")
  guild           Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  communitySlug   String    @default("VPGRoPS5") @map("community_slug")
  leagueSlug      String    @default("Superliga-Romania") @map("league_slug")
  leagueName      String    @default("Superliga România") @map("league_name")
  channelId       String?   @map("channel_id")
  enabled         Boolean   @default(true)
  pollIntervalSec Int       @default(120) @map("poll_interval_sec")
  lastPolledAt    DateTime? @map("last_polled_at")
  lastTransferId  Int?      @map("last_transfer_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("vpg_transfer_configs")
}

model ProcessedVpgTransfer {
  id               String   @id @default(uuid())
  transferId       Int      @map("transfer_id")
  guildId          String   @map("guild_id")
  guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  username         String
  fromName         String?  @map("from_name")
  fromSlug         String?  @map("from_slug")
  fromLogo         String?  @map("from_logo")
  toName           String?  @map("to_name")
  toSlug           String?  @map("to_slug")
  toLogo           String?  @map("to_logo")
  amount           Float    @default(0)
  occurredAt       DateTime @map("occurred_at")
  discordMessageId String?  @map("discord_message_id")
  channelId        String?  @map("channel_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([guildId, transferId])
  @@map("processed_vpg_transfers")
}

model ProcessedVpgMatch {
  id               String   @id @default(uuid())
  vpgMatchId       Int      @map("vpg_match_id")
  guildId          String   @map("guild_id")
  guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  homeName         String   @map("home_name")
  awayName         String   @map("away_name")
  homeScore        Int      @map("home_score")
  awayScore        Int      @map("away_score")
  matchDay         Int?     @map("match_day")
  datetime         DateTime
  discordMessageId String?  @map("discord_message_id")
  channelId        String?  @map("channel_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([guildId, vpgMatchId])
  @@map("processed_vpg_matches")
}



// Independent from the transfer poller; these switches govern the competition feeds.
model VpgNotificationConfig {
  guildId              String   @id @map("guild_id")
  guild                Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  pollIntervalSec      Int      @default(120) @map("poll_interval_sec")
  fixturesTime         String   @default("10:00") @map("fixtures_time")
  resultsEnabled       Boolean  @default(true) @map("results_enabled")
  ryvlResultsEnabled   Boolean  @default(true) @map("ryvl_results_enabled")
  fixturesEnabled      Boolean  @default(true) @map("fixtures_enabled")
  ryvlFixturesEnabled  Boolean  @default(true) @map("ryvl_fixtures_enabled")
  standingsEnabled     Boolean  @default(true) @map("standings_enabled")
  ryvlStandingsEnabled Boolean  @default(true) @map("ryvl_standings_enabled")
  lastPolledAt         DateTime? @map("last_polled_at")
  lastFixturesPolledAt DateTime? @map("last_fixtures_polled_at")
  lastSuccessAt        DateTime? @map("last_success_at")
  lastError            String?  @map("last_error")
  retryAfter           DateTime? @map("retry_after")
  leaseToken           String?  @map("lease_token")
  leaseUntil           DateTime? @map("lease_until")
  updatedAt            DateTime @updatedAt @map("updated_at")
  @@map("vpg_notification_configs")
}

model VpgNotificationDelivery {
  id                   String   @id @default(uuid())
  guildId              String   @map("guild_id")
  guild                Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId            String   @map("channel_id")
  topic                String
  itemKey              String   @map("item_key")
  fingerprint          String
  discordMessageId     String?  @map("discord_message_id")
  suppressed           Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  @@unique([guildId, channelId, topic, itemKey], map: "vpg_delivery_destination_key")
  @@index([guildId, topic])
  @@map("vpg_notification_deliveries")
}

model EaPlayerMatchStat {
  id                   String   @id @default(uuid())
  eaMatchId            String   @map("ea_match_id")
  clubId               String   @map("club_id")
  playerProId          String   @map("player_pro_id")
  playerProName        String   @map("player_pro_name")
  pos                  String?
  rating               Float    @default(0)
  goals                Int      @default(0)
  assists              Int      @default(0)
  shots                Int      @default(0)
  passesMade           Int      @default(0) @map("passes_made")
  passAttempts         Int      @default(0) @map("pass_attempts")
  tacklesMade          Int      @default(0) @map("tackles_made")
  tackleAttempts       Int      @default(0) @map("tackle_attempts")
  interceptions        Int      @default(0)
  saves                Int      @default(0)
  mom                  Int      @default(0)
  cleanSheetDef        Int      @default(0) @map("clean_sheet_def")
  cleanSheetGk         Int      @default(0) @map("clean_sheet_gk")
  cleanSheetsAny       Int      @default(0) @map("clean_sheets_any")
  redCards             Int      @default(0) @map("red_cards")
  yellowCards          Int      @default(0) @map("yellow_cards")
  fouls                Int      @default(0)
  dribbles             Int      @default(0)
  secondsPlayed        Int      @default(0) @map("seconds_played")
  goalsConceded        Int      @default(0) @map("goals_conceded")
  matchEventAggregate0 String?  @map("match_event_aggregate_0")
  matchEventAggregate1 String?  @map("match_event_aggregate_1")
  matchEventAggregate2 String?  @map("match_event_aggregate_2")
  matchEventAggregate3 String?  @map("match_event_aggregate_3")
  timestamp            DateTime
  createdAt            DateTime @default(now()) @map("created_at")

  @@unique([eaMatchId, playerProName, clubId])
  @@index([playerProName])
  @@index([clubId])
  @@map("ea_player_match_stats")
}

model TrackedClub {
  id              String    @id @default(uuid())
  guildId         String    @map("guild_id")
  guild           Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  clubId          String    @map("club_id")
  clubName        String    @map("club_name")
  channelId       String?   @map("channel_id")
  platform        String    @default("common-gen5")
  enabled         Boolean   @default(true)
  lastMatchId     String?   @map("last_match_id")
  lastPolledAt    DateTime? @map("last_polled_at")
  crestUrl        String?   @map("crest_url")
  elo             Int       @default(1200)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([guildId, clubId])
  @@map("tracked_clubs")
}

model RegisteredDiscordPlayer {
  id               String   @id @default(uuid())
  guildId          String   @map("guild_id")
  guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  discordUserId    String   @map("discord_user_id")
  eaPlayerName     String   @map("ea_player_name")
  preferredPos     String?  @map("preferred_pos")
  platform         String?  @default("common-gen5")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([guildId, discordUserId])
  @@index([guildId, eaPlayerName])
  @@map("registered_discord_players")
}

model PlayerRegistrationAudit {
  id               String   @id @default(uuid())
  guildId          String   @map("guild_id")
  action           String   // LINK, UNLINK, UPDATE
  discordUserId    String   @map("discord_user_id")
  eaPlayerName     String   @map("ea_player_name")
  performedById    String   @map("performed_by_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("player_registration_audits")
}

model TotwConfig {
  id             String    @id @default(uuid())
  guildId        String    @map("guild_id")
  guild          Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId      String?   @map("channel_id")
  communitySlug  String    @default("VPGRoPS5") @map("community_slug")
  leagueSlug     String    @default("Superliga-Romania") @map("league_slug")
  formation      String    @default("3-5-2")
  cronSchedule   String?   @default("0 18 * * 1") @map("cron_schedule")
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([guildId, leagueSlug])
  @@map("totw_configs")
}

model TournamentConfig {
  id                   String   @id @default(uuid())
  guildId              String   @unique @map("guild_id")
  guild                Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  adminChannelId       String?  @map("admin_channel_id")
  signupChannelId      String?  @map("signup_channel_id")
  tournamentCategoryId String?  @map("tournament_category_id")
  resultsChannelId     String?  @map("results_channel_id")
  chatChannelId        String?  @map("chat_channel_id")
  standingsChannelId   String?  @map("standings_channel_id")
  rostersChannelId     String?  @map("rosters_channel_id")
  adminRoleIds         String[] @default([]) @map("admin_role_ids")
  captainRoleIds       String[] @default([]) @map("captain_role_ids")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("tournament_configs")
}

model TournamentInstance {
  id                String   @id @default(uuid())
  guildId           String   @map("guild_id")
  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name              String
  type              String   @default("STANDARD") // STANDARD or DRAFT
  status            String   @default("PENDING") // PENDING, SIGNUPS_OPEN, DRAFTING, ACTIVE, COMPLETED
  formation         String   @default("3-1-4-2")
  teamsData         Json     @default("[]") @map("teams_data")
  signupsData       Json     @default("[]") @map("signups_data")
  matchesData       Json     @default("[]") @map("matches_data")
  currentDraftRound Int      @default(1) @map("current_draft_round")
  draftState        Json?    @map("draft_state")
  discordCategoryId String?  @map("discord_category_id")
  discordChannels   Json?    @map("discord_channels")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("tournament_instances")
}
