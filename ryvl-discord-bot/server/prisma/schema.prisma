generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id               String   @id // Discord guild snowflake
  name             String
  iconUrl          String?  @map("icon_url")
  timezone         String   @default("UTC")
  defaultChannelId String?  @map("default_channel_id")
  joinedAt         DateTime @default(now()) @map("joined_at")
  events           Event[]

  @@map("guilds")
}

model Event {
  id             String      @id @default(uuid())
  guildId        String      @map("guild_id")
  guild          Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  location       String?
  imageUrl       String?     @map("image_url")
  color          String      @default("#5865F2")
  channelId      String      @map("channel_id")
  timezone       String      @default("UTC")
  createdById    String      @map("created_by_id")
  mentionRoleIds String[]    @default([]) @map("mention_role_ids")
  rrule          String?     // RFC 5545 RRULE string, null = one-off
  duration       Int         @default(60) // Duration in minutes
  status         EventStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  occurrences    EventOccurrence[]

  @@map("events")
}

model EventOccurrence {
  id          String           @id @default(uuid())
  eventId     String           @map("event_id")
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  index       Int
  startsAt    DateTime         @map("starts_at")
  endsAt      DateTime?        @map("ends_at")
  status      OccurrenceStatus @default(SCHEDULED)
  messageId   String?          @map("message_id")
  channelId   String?          @map("channel_id")
  publishedAt DateTime?        @map("published_at")
  closedAt    DateTime?        @map("closed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  rsvps       Rsvp[]

  @@unique([eventId, index])
  @@map("event_occurrences")
}

model Rsvp {
  id           String          @id @default(uuid())
  occurrenceId String          @map("occurrence_id")
  occurrence   EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  userId       String          @map("user_id")
  displayName  String          @map("display_name")
  avatarUrl    String?         @map("avatar_url")
  status       RsvpStatus
  respondedAt  DateTime        @default(now()) @map("responded_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@unique([occurrenceId, userId])
  @@map("rsvps")
}

enum EventStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OccurrenceStatus {
  SCHEDULED
  PUBLISHED
  CLOSED
  CANCELLED
}

enum RsvpStatus {
  ACCEPTED
  TENTATIVE
  DECLINED
}
